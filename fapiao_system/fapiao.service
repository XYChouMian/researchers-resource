[Unit]
Description=发票管理系统 (Flask)
After=network.target

[Service]
Type=simple
User=hzx
WorkingDirectory=/mnt/data1/resources/fapiao_system
ExecStart=/home/hzx/anaconda3/bin/python /mnt/data1/resources/fapiao_system/app.py
Environment=FAPIAO_PREFIX=/fapiao
Environment=FAPIAO_PORT=8085
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
